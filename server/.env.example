PORT=5000
# Public address of the site (used to build the event login links)
PUBLIC_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
GOOGLE_FONTS=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=event_checkin

# First super admin (created by `npm run db:setup`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

MAX_GUESTS_PER_EVENT=1000
# Timezone used to decide when an event link expires (end of the day AFTER the event)
APP_TZ_OFFSET=+03:00
